__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.venv/
venv/

# run artefacts
output/*
!output/.gitkeep
runs/
# Sessions collect.py writes. The trailing '_' is what keeps the bundled, tracked
# data/SampleData/sample_train/ out of this pattern - only sample_train_<MMDD>/ matches.
# Everything Data.py collects: projected/, raw_<MMDD>/, warp_<MMDD>/.
data/Create_Data/
# pre-0813 sessions, kept so an existing one stays ignored
data/SampleData/sample_train_*/
# pre-0812 session folders, kept so an existing one stays ignored
data/collected_*/
data/recordings/
paper/
# weights/*.pt and *.pth are committed on purpose (51 MiB) so a clone runs as-is.
# Checkpoints you train yourself land in runs/, which is ignored above.
